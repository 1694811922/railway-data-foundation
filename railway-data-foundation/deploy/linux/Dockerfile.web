FROM node:22-bookworm-slim AS build
WORKDIR /build
COPY foundation-web/package*.json ./
RUN npm ci
COPY foundation-web ./
ENV VITE_API_BASE_URL=/api/v1 VITE_USE_MOCK=false
RUN npm run build

FROM nginx:stable-alpine
COPY --from=build /build/dist /usr/share/nginx/html
ENTRYPOINT ["nginx", "-g", "daemon off;"]
