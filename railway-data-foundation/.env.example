# Copy to .env, replace all CHANGE_ME values. Never commit .env.
MYSQL_IMAGE=mysql:8.0.33
FLYWAY_IMAGE=flyway/flyway:11.7.2
MYSQL_BIND=127.0.0.1
FOUNDATION_MYSQL_PORT=13306
SOURCE_MYSQL_PORT=13307
FOUNDATION_DB_NAME=foundation_db
SOURCE_DB_NAME=port_source_db
FOUNDATION_MYSQL_ROOT_PASSWORD=CHANGE_ME_FOUNDATION_ROOT
SOURCE_MYSQL_ROOT_PASSWORD=CHANGE_ME_SOURCE_ROOT
FOUNDATION_DB_USER=foundation_app
FOUNDATION_DB_PASSWORD=CHANGE_ME_FOUNDATION_APP
SOURCE_DB_USER=source_app
SOURCE_DB_PASSWORD=CHANGE_ME_SOURCE_APP
SOURCE_DB_HOST=127.0.0.1
SOURCE_DB_PORT=13307
SOURCE_DB_DATABASE=port_source_db
SOURCE_DB_SSL_MODE=DISABLED
# Dynamic data sources use one service-wide encryption key, not one environment group per source.
# Configure FOUNDATION_CREDENTIAL_KEY as a Base64-encoded random 32-byte key outside the database.
# Local start-local.ps1 generates and preserves it in ignored .env.local automatically.
# Back up the key with the encrypted database; do not change or regenerate it on restart.
# Optional Kafka for Provider production and Foundation Topic metadata verification.
# Start a Broker and create the Topic before enabling these settings.
# PROVIDER_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
# PROVIDER_KAFKA_TOPIC=port.container.event.v1
# FOUNDATION_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
# FOUNDATION_KAFKA_TOPIC=port.container.event.v1
FOUNDATION_BIND=127.0.0.1
FOUNDATION_PORT=18080
# Provider checks REST capability state here before reading business rows.
# Only an operator-configured Foundation host is allowed; this is not a client-supplied URL.
PROVIDER_FOUNDATION_BASE_URL=http://127.0.0.1:18080
FOUNDATION_DB_URL=jdbc:mysql://127.0.0.1:13306/foundation_db?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&sslMode=DISABLED
# Used only inside the Compose network by the Flyway source migration job.
SOURCE_MIGRATION_URL=jdbc:mysql://mysql-source:3306/port_source_db?allowPublicKeyRetrieval=true&sslMode=DISABLED
