# Copy to .env, replace all CHANGE_ME values. Never commit .env.
MYSQL_IMAGE=mysql:8.0.33
FLYWAY_IMAGE=flyway/flyway:11.7.2
MYSQL_BIND=127.0.0.1
FOUNDATION_MYSQL_PORT=13306
SOURCE_MYSQL_PORT=13307
FOUNDATION_DB_NAME=foundation_db
SOURCE_DB_NAME=port_source_db
FOUNDATION_MYSQL_ROOT_PASSWORD=CHANGE_ME_FOUNDATION_ROOT
SOURCE_MYSQL_ROOT_PASSWORD=CHANGE_ME_SOURCE_ROOT
FOUNDATION_DB_USER=foundation_app
FOUNDATION_DB_PASSWORD=CHANGE_ME_FOUNDATION_APP
SOURCE_DB_USER=source_app
SOURCE_DB_PASSWORD=CHANGE_ME_SOURCE_APP
SOURCE_DB_HOST=127.0.0.1
SOURCE_DB_PORT=13307
SOURCE_DB_DATABASE=port_source_db
SOURCE_DB_SSL_MODE=DISABLED
# Dynamic data sources use one service-wide encryption key, not one environment group per source.
# Configure FOUNDATION_CREDENTIAL_KEY as a Base64-encoded random 32-byte key outside the database.
# Local start-local.ps1 generates and preserves it in ignored .env.local automatically.
# Back up the key with the encrypted database; do not change or regenerate it on restart.
# Optional Kafka for Provider production and Foundation Topic metadata verification.
# Start a Broker and create the Topic before enabling these settings.
# Both backend processes must use the same Topic; NONE/PLAINTEXT is loopback development only.
# PROVIDER_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
# PROVIDER_KAFKA_TOPIC=port.container.event.v1
# FOUNDATION_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
# FOUNDATION_KAFKA_TOPIC=port.container.event.v1
FOUNDATION_BIND=127.0.0.1
FOUNDATION_PORT=18080
# Provider checks REST capability state here before reading business rows.
# Only an operator-configured Foundation host is allowed; this is not a client-supplied URL.
PROVIDER_FOUNDATION_BASE_URL=http://127.0.0.1:18080
# Both Foundation and Provider need the same random service-to-service token.
# start-local.ps1 generates it in ignored .env.local; never put it in frontend code.
# PROVIDER_CONTROL_TOKEN=REPLACE_WITH_STRONG_RANDOM_BASE64URL_VALUE
# Foundation assigns this trusted collector ID; a report cannot self-select another node.
PROVIDER_TELEMETRY_NODE_ID=provider-local
# Asynchronous execution summaries; all settings are backend-only (never VITE_*).
PROVIDER_TELEMETRY_ENABLED=true
PROVIDER_TELEMETRY_SPOOL_DIR=.runtime/local/telemetry
PROVIDER_TELEMETRY_QUEUE_CAPACITY=1000
PROVIDER_TELEMETRY_MAX_PENDING_REPORTS=1000
# Optional independent summary receiver; authorization continues to use PROVIDER_FOUNDATION_BASE_URL.
# PROVIDER_TELEMETRY_BASE_URL=http://127.0.0.1:18080
# Business DATETIME values in the demo Source use this fixed offset.
PROVIDER_SOURCE_TIME_OFFSET=+08:00
FOUNDATION_DB_URL=jdbc:mysql://127.0.0.1:13306/foundation_db?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&sslMode=DISABLED
# Used only inside the Compose network by the Flyway source migration job.
SOURCE_MIGRATION_URL=jdbc:mysql://mysql-source:3306/port_source_db?allowPublicKeyRetrieval=true&sslMode=DISABLED

# Kafka authentication is backend-only; never place these credentials in VITE_* variables.
# NONE is the default and only accepts loopback PLAINTEXT. SASL_PLAINTEXT is loopback testing only.
# Remote Brokers require SASL_SSL. Authentication type must match the registered capability.
# Use separate least-privilege accounts: Foundation describes metadata; Provider produces messages.
# FOUNDATION_KAFKA_SECURITY_PROTOCOL=SASL_SSL
# FOUNDATION_KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# FOUNDATION_KAFKA_USERNAME=foundation_probe
# FOUNDATION_KAFKA_PASSWORD=CHANGE_ME_SEPARATE_BROKER_PASSWORD
# PROVIDER_KAFKA_AUTH_TYPE=SASL
# PROVIDER_KAFKA_SECURITY_PROTOCOL=SASL_SSL
# PROVIDER_KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# PROVIDER_KAFKA_USERNAME=provider_writer
# PROVIDER_KAFKA_PASSWORD=CHANGE_ME_SEPARATE_BROKER_PASSWORD
# Optional private CA truststore, otherwise use JVM default trust roots and hostname verification.
# FOUNDATION_KAFKA_SSL_TRUSTSTORE_LOCATION=/secure/foundation-truststore.jks
# FOUNDATION_KAFKA_SSL_TRUSTSTORE_PASSWORD=CHANGE_ME_TRUSTSTORE_PASSWORD
# PROVIDER_KAFKA_SSL_TRUSTSTORE_LOCATION=/secure/provider-truststore.jks
# PROVIDER_KAFKA_SSL_TRUSTSTORE_PASSWORD=CHANGE_ME_TRUSTSTORE_PASSWORD

# Subscription execution is opt-in; keep disabled when no managed authenticated Broker is available.
KAFKA_SUBSCRIPTION_EXECUTION_ENABLED=false
# Pin the real cluster ID from the operator's Broker; never silently change it for existing identities.
# KAFKA_SUBSCRIPTION_CLUSTER_ID=ACTUAL_KAFKA_CLUSTER_ID
# Separate administrator identity; never use the Foundation probe or Provider writer account here.
# KAFKA_SUBSCRIPTION_ADMIN_BOOTSTRAP_SERVERS=broker.example:9093
# KAFKA_SUBSCRIPTION_ADMIN_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SUBSCRIPTION_ADMIN_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SUBSCRIPTION_ADMIN_USERNAME=subscription_operator
# KAFKA_SUBSCRIPTION_ADMIN_PASSWORD=CHANGE_ME_SEPARATE_ADMIN_PASSWORD
# KAFKA_SUBSCRIPTION_ADMIN_SSL_TRUSTSTORE_LOCATION=/secure/subscription-admin.jks
# KAFKA_SUBSCRIPTION_ADMIN_SSL_TRUSTSTORE_PASSWORD=CHANGE_ME_TRUSTSTORE_PASSWORD
# Single-instance bounded reconciliation; elapsed revocation time also depends on backlog and Broker availability.
# KAFKA_SUBSCRIPTION_RECONCILE_MS=5000
# 首次管理员网页注册：只允许绑定回环地址的本机环境；远程部署或反向代理必须关闭。
FOUNDATION_REGISTRATION_LOCAL_BOOTSTRAP_ENABLED=false

# 独立需求方服务：数据库必须与底座和业务源分开，秘密仅放在服务端私有配置。
DEMAND_BIND=127.0.0.1
DEMAND_PORT=18082
DEMAND_FOUNDATION_URL=http://127.0.0.1:18080
DEMAND_DB_NAME=demand_receiver_db
# DEMAND_DB_URL=jdbc:mysql://127.0.0.1:13306/demand_receiver_db?serverTimezone=UTC
# DEMAND_DB_USER=demand_receiver_app
# DEMAND_DB_PASSWORD=SET_PRIVATE_DATABASE_PASSWORD
# DEMAND_CREDENTIAL_KEY=BASE64_OF_INDEPENDENT_RANDOM_32_BYTES
# DEMAND_KAFKA_SSL_TRUSTSTORE_LOCATION=/secure/demand-truststore.jks
# DEMAND_KAFKA_SSL_TRUSTSTORE_PASSWORD=SET_PRIVATE_TRUSTSTORE_PASSWORD
